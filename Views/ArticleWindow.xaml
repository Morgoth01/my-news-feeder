<Window x:Class="MyNewsFeeder.Views.ArticleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Article"
        Height="760"
        Width="980"
        MinHeight="520"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        PreviewKeyDown="Window_PreviewKeyDown"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder"
                Grid.Row="0"
                Padding="10"
                Margin="0,0,0,8"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock x:Name="ArticleTitleText"
                               FontWeight="SemiBold"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ArticleLinkText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="ShowContentButton"
                        Content="Show Content"
                        Click="ShowContentButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"/>

                <Button Grid.Column="2"
                        x:Name="ReaderModeButton"
                        Content="Reader Mode"
                        Click="ReaderModeButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"/>

                <Button Grid.Column="3"
                        x:Name="EnableVideoButton"
                        Content="Allow Media"
                        Click="EnableVideoButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        ToolTip="Allow embedded media on this page. Some sites need this for custom video players."
                        VerticalAlignment="Top"
                        Visibility="Collapsed"/>

                <Button Grid.Column="4"
                        x:Name="RefreshPageButton"
                        ToolTip="Reload article"
                        Click="RefreshPageButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="40"
                        Height="40"
                        Padding="6"
                        VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="Refresh"
                                             Width="20"
                                             Height="20"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ToolBar x:Name="FullscreenToolbar"
                         Grid.Row="0"
                         Style="{StaticResource MaterialDesignToolBar}"
                         Visibility="Collapsed">
                    <Button x:Name="FullscreenRefreshButton"
                            ToolTip="Reload article"
                            Click="RefreshPageButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="40"
                            Height="40"
                            Padding="6">
                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="20"
                                                 Height="20"
                                                 Foreground="{DynamicResource MaterialDesignBody}"/>
                    </Button>
                    <Button x:Name="FullscreenEnableVideoButton"
                            ToolTip="Allow embedded media on this page. Some sites need this for custom video players."
                            Click="EnableVideoButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="40"
                            Padding="10,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline"
                                                     Width="20"
                                                     Height="20"
                                                     Margin="0,0,6,0"
                                                     Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text="Allow Media"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator x:Name="FullscreenEnableVideoSeparator"
                               Visibility="Collapsed"/>
                    <Separator/>
                    <Button x:Name="FullscreenExitButton"
                            Click="FullscreenButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="40"
                            Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FullscreenExit"
                                                     Width="20"
                                                     Height="20"
                                                     Margin="0,0,6,0"
                                                     Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text="Exit Fullscreen"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator/>
                    <TextBlock x:Name="FullscreenLinkTextBlock"
                               VerticalAlignment="Center"
                               Margin="5,0"
                               FontStyle="Italic"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="520"/>
                </ToolBar>

                <wv:WebView2 x:Name="ArticleContentWebView"
                             Grid.Row="1"
                             Margin="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>