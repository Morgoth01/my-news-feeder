<Window x:Class="MyNewsFeeder.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Help"
        Height="700"
        Width="980"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16">
            <TextBlock Text="Help"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
            <TextBlock Text="Select a topic on the left."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Topics"
                      Style="{StaticResource MaterialDesignCardGroupBox}"
                      Margin="0,0,5,0">
                <ListBox x:Name="TopicsListBox"
                         Margin="8"
                         SelectionChanged="TopicsListBox_SelectionChanged"
                         DisplayMemberPath="Title"
                         Style="{StaticResource MaterialDesignListBox}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"/>

            <GroupBox Grid.Column="2"
                      Header="Content"
                      Style="{StaticResource MaterialDesignCardGroupBox}"
                      Margin="5,0,0,0">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TopicTitleText"
                               Grid.Row="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <FlowDocumentScrollViewer x:Name="TopicContentViewer"
                                              Grid.Row="1"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent"
                                              BorderThickness="0"/>
                </Grid>
            </GroupBox>
        </Grid>

        <Button Grid.Row="2"
                Content="Close"
                Click="CloseButton_Click"
                Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Right"
                Width="110"
                Margin="0,14,0,0"/>
    </Grid>
</Window>