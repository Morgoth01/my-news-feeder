<Window x:Class="MyNewsFeeder.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Settings"
        Height="720"
        Width="980"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Loaded="SettingsDialog_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                   Margin="0,0,0,16"
                   HorizontalAlignment="Center"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Topics"
                      Style="{StaticResource MaterialDesignCardGroupBox}">
                <ListBox x:Name="TopicsListBox"
                         SelectionChanged="TopicsListBox_SelectionChanged"
                         Style="{StaticResource MaterialDesignListBox}"
                         Margin="8">
                    <ListBoxItem Content="General" Tag="general" IsSelected="True"/>
                    <ListBoxItem Content="Terminal (Preview)" Tag="terminal"/>
                    <ListBoxItem Content="Refresh" Tag="refresh"/>
                    <ListBoxItem Content="Feed Settings" Tag="feed"/>
                    <ListBoxItem Content="Adblocker" Tag="adblocker"/>
                    <ListBoxItem Content="Filtering and Notifications" Tag="filter"/>
                    <ListBoxItem Content="Tools" Tag="tools"/>
                </ListBox>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="Settings"
                      Style="{StaticResource MaterialDesignCardGroupBox}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SelectedTopicTitle"
                               Grid.Row="0"
                               Text="General"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <StackPanel x:Name="GeneralPanel">
                                <CheckBox Content="Dark Mode"
                                          IsChecked="{Binding PendingDarkMode}"
                                          Margin="0,2"/>
                                <TextBlock Text="Dark mode applies to app surfaces, article view, and browser panel."
                                           Margin="20,2,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="For websites: only native website dark themes are used (no CSS filter forcing)."
                                           Margin="20,2,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap"/>
                                <CheckBox Content="Show Content Always-On"
                                          IsChecked="{Binding IsShowContentAlwaysOn}"
                                          Margin="0,8,0,2"
                                          ToolTip="Keep browser window open and auto-load articles when switching"/>
                                <TextBlock Text="When enabled, the content panel stays open and automatically loads the newly selected article."
                                           Margin="20,2,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel x:Name="TerminalPanel"
                                        Visibility="Collapsed">
                                <CheckBox Content="Open app in Terminal Mode by default"
                                          IsChecked="{Binding PendingStartInTerminal}"
                                          Margin="0,2"/>
                                <TextBlock Text="When enabled, future app launches open the terminal first. Closing the terminal returns to the GUI."
                                           Margin="20,2,0,8"
                                           FontSize="10"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,4,0,6">
                                    <TextBlock Text="Terminal theme:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox Width="180"
                                              ItemsSource="{Binding AvailableTerminalThemes}"
                                              SelectedItem="{Binding PendingTerminalThemeName}"
                                              Style="{StaticResource MaterialDesignComboBox}"/>
                                </StackPanel>
                                <TextBlock Text="Theme changes apply to newly opened terminal windows and are shared with the terminal 'theme' command."
                                           Margin="20,0,0,8"
                                           FontSize="10"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap"/>

                                <CheckBox Content="Play terminal boot animation"
                                          IsChecked="{Binding PendingTerminalBootAnimationEnabled}"
                                          Margin="0,4,0,2"/>
                                <TextBlock Text="Disable this for a faster terminal startup. You can still preview it with the terminal command 'bootanim preview'."
                                           Margin="20,2,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel x:Name="RefreshPanel"
                                        Visibility="Collapsed">
                                <CheckBox Content="Auto Refresh"
                                          IsChecked="{Binding PendingAutoRefresh}"
                                          Margin="0,2"/>
                                <CheckBox Content="Live Refresh"
                                          IsChecked="{Binding PendingLiveRefresh}"
                                          Margin="20,2,0,6"
                                          ToolTip="Use fast polling. Disable to use manual interval."
                                          Visibility="{Binding IsAutoRefreshModeOptionsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="20,0,0,6"
                                            Visibility="{Binding IsLiveRefreshSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Live interval:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox Width="120"
                                              ItemsSource="{Binding AvailableLiveRefreshIntervals}"
                                              SelectedItem="{Binding PendingLiveRefreshIntervalSeconds}"
                                              Style="{StaticResource MaterialDesignComboBox}"
                                              ToolTip="60s recommended; 10s is expert mode">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} sec">
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Border Margin="20,2,0,8"
                                        Padding="8,6"
                                        CornerRadius="4"
                                        BorderThickness="2"
                                        BorderBrush="#FFB00020"
                                        Background="#FFFDE9EC"
                                        Visibility="{Binding IsLiveRefreshExpertModeWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Warning: 10s increases load and can trigger feed timeouts or rate limits."
                                               FontSize="11"
                                               FontWeight="ExtraBold"
                                               Foreground="#FFB00020"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <StackPanel Orientation="Horizontal"
                                            Margin="20,0,0,4"
                                            Visibility="{Binding IsIntervalAutoRefreshSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Interval:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox Width="120"
                                              ItemsSource="{Binding AvailableRefreshIntervals}"
                                              SelectedItem="{Binding PendingAutoRefreshIntervalMinutes}"
                                              Style="{StaticResource MaterialDesignComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} min">
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="{Binding AutoRefreshIntervalDisplay}"
                                           FontSize="10"
                                           Margin="20,0,0,2"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Visibility="{Binding PendingAutoRefresh, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding NextAutoRefreshDisplay}"
                                           FontSize="10"
                                           Margin="20,0,0,2"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Visibility="{Binding PendingAutoRefresh, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel x:Name="FeedPanel"
                                        Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,2,0,6">
                                    <TextBlock Text="Max Articles per Feed:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox Width="64"
                                             Text="{Binding MaxFeeds, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignTextBox}"/>
                                    <TextBlock Text="(1-50)"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentFeedSettingsDisplay}"
                                           FontSize="10"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel x:Name="FilterPanel"
                                        Visibility="Collapsed">
                                <CheckBox Content="Hide advertisement articles"
                                          IsChecked="{Binding PendingAdvertisementFilterEnabled}"
                                          Margin="0,2"
                                          ToolTip="Filter feed items that look like ads based on configurable keywords."/>
                                <TextBlock Text="Filter keywords (one per line)"
                                           Margin="20,2,0,2"
                                           FontSize="10"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Visibility="{Binding PendingAdvertisementFilterEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding PendingAdvertisementKeywordsText, UpdateSourceTrigger=LostFocus}"
                                         AcceptsReturn="True"
                                         Height="110"
                                         Margin="20,0,0,8"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource MaterialDesignTextBox}"
                                         Visibility="{Binding PendingAdvertisementFilterEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         TextWrapping="Wrap"/>

                                <CheckBox Content="Desktop notifications for important items in GUI mode"
                                          IsChecked="{Binding PendingDesktopNotificationsEnabled}"
                                          Margin="0,2"/>
                                <TextBlock Text="Important keywords (one per line)"
                                           Margin="20,2,0,2"
                                           FontSize="10"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Visibility="{Binding PendingDesktopNotificationsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding PendingImportantKeywordsText, UpdateSourceTrigger=LostFocus}"
                                         AcceptsReturn="True"
                                         Height="92"
                                         Margin="20,0,0,2"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource MaterialDesignTextBox}"
                                         Visibility="{Binding PendingDesktopNotificationsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel x:Name="AdblockerPanel"
                                        Visibility="Collapsed">
                                <CheckBox Content="Enable AdBlocker"
                                          IsChecked="{Binding PendingAdBlockerEnabled}"
                                          Margin="0,2"/>
                                <Button Content="AdBlocker Settings"
                                        Command="{Binding AdBlockerSettingsCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                            <Setter Property="TextElement.Foreground" Value="#FFFFFFFF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="ToolsPanel"
                                        Visibility="Collapsed">
                                <Button Content="Clear Browser Cache"
                                        Command="{Binding ClearCacheCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="0,0,0,6"
                                        HorizontalAlignment="Left"
                                        ToolTip="Clear cached images, files and browsing data to free up space"/>
                                <TextBlock Text="Automatically clears old cache every 2 hours"
                                           FontSize="10"
                                           Margin="0,0,0,8"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Reset to Default"
                    Command="{Binding ResetSettingsCommand}"
                    Margin="0,0,8,0">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Background" Value="#FF5F6368"/>
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        <Setter Property="TextElement.Foreground" Value="#FFFFFFFF"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Close"
                    Click="CloseButton_Click"
                    Margin="0,0,0,0">
                <Button.Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>