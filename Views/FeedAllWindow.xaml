<Window x:Class="MyNewsFeeder.Views.FeedAllWindow"
        x:Name="FeedAllWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:MyNewsFeeder.Models"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Feed"
        Height="860"
        Width="1440"
        MinHeight="620"
        MinWidth="1080"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <Style x:Key="FeedWindowContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeedWindowMenuItemStyle" TargetType="MenuItem">
            <Style.Resources>
                <Style TargetType="materialDesign:PackIcon">
                    <Setter Property="Foreground"
                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                </Style>
            </Style.Resources>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPaper}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeedWindowActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.DarkMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#F7F2FF"/>
                    <Setter Property="BorderBrush" Value="#C7A6FF"/>
                    <Setter Property="Background" Value="#4D4D4D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FeedWindowPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderPanel"
                Grid.Row="0"
                Padding="14"
                Margin="0,0,0,10"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0"
                      Grid.Column="0"
                      Margin="0,0,16,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FeedTitleTextBlock"
                               Grid.Row="0"
                               Grid.Column="0"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Text="Feed"/>
                    <ComboBox x:Name="FeedSelectorComboBox"
                              Grid.Row="0"
                              Grid.Column="2"
                              Margin="0,2,0,0"
                              VerticalAlignment="Center"
                              MinWidth="220"
                              materialDesign:HintAssist.Hint="Switch feed"
                              DisplayMemberPath="Name"
                              SelectionChanged="FeedSelectorComboBox_SelectionChanged"/>
                    <TextBlock x:Name="FeedSubtitleTextBlock"
                               Grid.Row="1"
                               Grid.ColumnSpan="3"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Browse all currently available items from this RSS feed."/>
                </Grid>

                <Button Grid.Row="0"
                        Grid.Column="1"
                        x:Name="RefreshFeedButton"
                        Content="Refresh Feed"
                        Click="RefreshButton_Click"
                        Style="{StaticResource FeedWindowPrimaryButtonStyle}"
                        Margin="0,0,10,10"/>
                <Button Grid.Row="0"
                        Grid.Column="2"
                        x:Name="ShowContentButton"
                        Content="Show Content"
                        Click="ShowContentButton_Click"
                        Style="{StaticResource FeedWindowActionButtonStyle}"
                        Margin="0,0,10,10"/>
                <Button Grid.Row="0"
                        Grid.Column="3"
                        x:Name="ReaderModeButton"
                        Content="Reader Mode"
                        Click="ReaderModeButton_Click"
                        Style="{StaticResource FeedWindowActionButtonStyle}"
                        Margin="0,0,10,10"/>
                <Button Grid.Row="0"
                        Grid.Column="4"
                        x:Name="EnableVideoButton"
                        Content="Allow Media"
                        Click="EnableVideoButton_Click"
                        Style="{StaticResource FeedWindowActionButtonStyle}"
                        Margin="0,0,10,10"
                        ToolTip="Allow embedded media on this page. Some sites need this for custom video players."
                        Visibility="Collapsed"/>
                <Button Grid.Row="0"
                        Grid.Column="5"
                        x:Name="RefreshPageButton"
                        Content="Refresh Page"
                        Click="RefreshPageButton_Click"
                        Style="{StaticResource FeedWindowActionButtonStyle}"
                        Margin="0,0,10,10"/>
                <Button Grid.Row="0"
                        Grid.Column="6"
                        x:Name="FullscreenButton"
                        Content="Fullscreen"
                        Click="FullscreenButton_Click"
                        Style="{StaticResource FeedWindowActionButtonStyle}"
                        Margin="0,0,10,10"/>
                <Button Grid.Row="0"
                        Grid.Column="7"
                        x:Name="OpenArticleButton"
                        Content="Open Article"
                        Click="OpenArticleButton_Click"
                        Style="{StaticResource FeedWindowPrimaryButtonStyle}"
                        Margin="0,0,0,10"/>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             materialDesign:HintAssist.Hint="Search title, description, link"
                             TextChanged="FilterControl_Changed"/>
                    <ComboBox x:Name="ReadStateComboBox"
                              Grid.Column="2"
                              SelectionChanged="FilterControl_Changed"
                              materialDesign:HintAssist.Hint="Read state"/>
                    <TextBlock x:Name="LoadedCountTextBlock"
                               Grid.Column="4"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Loading items..."/>
                    <ProgressBar x:Name="LoadingProgressBar"
                                 Grid.Column="6"
                                 Width="120"
                                 Height="4"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArticlesColumn" Width="390"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ArticlesListPane"
                    Grid.Column="0"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ListView x:Name="ArticlesListView"
                          Margin="1"
                          MouseDoubleClick="ArticlesListView_MouseDoubleClick"
                          PreviewMouseWheel="ArticlesListView_PreviewMouseWheel"
                          SelectionChanged="ArticlesListView_SelectionChanged"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                Padding="0"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:FeedItem}">
                            <Border x:Name="ArticleCard"
                                    Padding="10,8"
                                    Margin="18,3,6,3"
                                    CornerRadius="8"
                                    MinHeight="126"
                                    MaxHeight="126"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="2">
                                <Border.ContextMenu>
                                    <ContextMenu Opened="ArticleContextMenu_Opened"
                                                 Style="{StaticResource FeedWindowContextMenuStyle}">
                                        <MenuItem Tag="pin"
                                                  Click="ContextPin_Click"
                                                  IsCheckable="True"
                                                  Style="{StaticResource FeedWindowMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="PinOutline"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Tag="readlater"
                                                  Click="ContextReadLater_Click"
                                                  IsCheckable="True"
                                                  Style="{StaticResource FeedWindowMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="ClockOutline"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Tag="archive"
                                                  Click="ContextArchive_Click"
                                                  IsCheckable="True"
                                                  Style="{StaticResource FeedWindowMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="ArchiveOutline"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Tag="unread"
                                                  Header="Unread"
                                                  Click="ContextMarkUnread_Click"
                                                  Style="{StaticResource FeedWindowMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EmailOutline"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Copy Link"
                                                  Click="ContextCopyLink_Click"
                                                  Style="{StaticResource FeedWindowMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="ContentCopy"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Show Content"
                                                  Click="ContextShowContent_Click"
                                                  Style="{StaticResource FeedWindowMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="OpenInApp"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Reader Mode"
                                                  Click="ContextReaderMode_Click"
                                                  Style="{StaticResource FeedWindowMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="TextBoxSearchOutline"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open Article"
                                                  Click="ContextOpenArticle_Click"
                                                  Style="{StaticResource FeedWindowMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="OpenInNew"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="UnreadStripe"
                                               Width="4"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Fill="{DynamicResource UnreadDotBrush}"
                                               VerticalAlignment="Stretch"
                                               Visibility="Collapsed"/>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0">
                                        <TextBlock x:Name="TitleText"
                                                   Text="{Binding Title}"
                                                   Foreground="{DynamicResource MaterialDesignBody}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   LineHeight="18"
                                                   Height="36">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock x:Name="DescriptionText"
                                                   Text="{Binding Description}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   Margin="0,4,0,6"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   LineHeight="17"
                                                   Height="32"/>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ClockOutline"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                     Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding PublicationDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       FontSize="11"/>
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       ItemHeight="18">
                                                <Border x:Name="PinnedStateLabel"
                                                        Padding="6,1"
                                                        Margin="0,0,4,0"
                                                        CornerRadius="999"
                                                        Background="#164C6EE3"
                                                        BorderBrush="#4C6EE3"
                                                        BorderThickness="1"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="Pinned"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="#D9E7FF"/>
                                                </Border>
                                                <Border x:Name="ReadLaterStateLabel"
                                                        Padding="6,1"
                                                        Margin="0,0,4,0"
                                                        CornerRadius="999"
                                                        Background="#16FFB74D"
                                                        BorderBrush="#FFB74D"
                                                        BorderThickness="1"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="Read later"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FFF1D0"/>
                                                </Border>
                                                <Border x:Name="ArchiveStateLabel"
                                                        Padding="6,1"
                                                        Margin="0"
                                                        CornerRadius="999"
                                                        Background="#1690A4AE"
                                                        BorderBrush="#90A4AE"
                                                        BorderThickness="1"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="Archived"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="#E4EDF1"/>
                                                </Border>
                                            </WrapPanel>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                    <Setter TargetName="ArticleCard" Property="Opacity" Value="0.9"/>
                                    <Setter TargetName="DescriptionText" Property="Opacity" Value="0.85"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter TargetName="UnreadStripe" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter TargetName="PinnedStateLabel" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadLater}" Value="True">
                                    <Setter TargetName="ReadLaterStateLabel" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                    <Setter TargetName="ArchiveStateLabel" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                    <Setter TargetName="ArticleCard" Property="Background" Value="#1A7C4DFF"/>
                                    <Setter TargetName="ArticleCard" Property="BorderBrush" Value="#7C4DFF"/>
                                    <Setter TargetName="ArticleCard" Property="BorderThickness" Value="3"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <GridSplitter x:Name="ContentSplitter"
                          Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <Border x:Name="PreviewPane"
                    Grid.Column="2"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitleTextBlock"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Select an article"/>
                            <TextBlock x:Name="PreviewMetaTextBlock"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Text="The selected article will appear here."/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid x:Name="PreviewEmptyStateGrid">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <materialDesign:PackIcon x:Name="PreviewEmptyIcon"
                                                         Kind="Rss"
                                                         Width="48"
                                                         Height="48"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PreviewEmptyTitleTextBlock"
                                           Text="Select an article"
                                           Margin="0,16,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PreviewEmptyBodyTextBlock"
                                           Text="Use Show Content or Reader Mode to inspect the selected feed item."
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           Width="360"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PreviewBrowserContainer"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ToolBar x:Name="PreviewFullscreenToolbar"
                                     Grid.Row="0"
                                     Style="{StaticResource MaterialDesignToolBar}"
                                     Visibility="Collapsed"
                                     Panel.ZIndex="30">
                                <Button x:Name="PreviewFullscreenRefreshButton"
                                        ToolTip="Reload article"
                                        Click="PreviewFullscreenRefreshButton_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Width="40"
                                        Height="40"
                                        Padding="6">
                                    <materialDesign:PackIcon Kind="Refresh"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                                </Button>
                                <Button x:Name="PreviewFullscreenEnableVideoButton"
                                        ToolTip="Allow embedded media on this page. Some sites need this for custom video players."
                                        Click="EnableVideoButton_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Height="40"
                                        Padding="10,0"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlayCircleOutline"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,6,0"
                                                                 Foreground="{DynamicResource MaterialDesignBody}"/>
                                        <TextBlock Text="Allow Media"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Separator x:Name="PreviewFullscreenVideoSeparator"
                                           Visibility="Collapsed"/>
                                <Button x:Name="PreviewFullscreenOverlayButton"
                                        Click="FullscreenButton_Click"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Height="40"
                                        Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FullscreenExit"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,6,0"
                                                                 Foreground="{DynamicResource MaterialDesignBody}"/>
                                        <TextBlock Text="Exit Fullscreen"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Separator/>
                                <TextBlock x:Name="PreviewFullscreenLinkTextBlock"
                                           VerticalAlignment="Center"
                                           Margin="5,0"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="420"/>
                            </ToolBar>

                            <wv:WebView2 x:Name="PreviewWebView"
                                         Grid.Row="1"
                                         Margin="1"/>

                            <Grid x:Name="PreviewLoadingOverlay"
                                  Grid.RowSpan="2"
                                  Background="{DynamicResource MaterialDesignPaper}"
                                  Panel.ZIndex="20"
                                  IsHitTestVisible="True"
                                  Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">
                                    <Image Source="pack://application:,,,/Resources/mynewsfeeder.ico"
                                           Width="88"
                                           Height="88"
                                           Margin="0,0,0,10"
                                           Stretch="Uniform"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <RotateTransform x:Name="FeedAllLogoSpinner" Angle="0"/>
                                        </Image.RenderTransform>
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="FeedAllLogoSpinner"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0"
                                                                         To="360"
                                                                         Duration="0:0:1.25"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                    <TextBlock Text="Loading page..."
                                               Foreground="{DynamicResource MaterialDesignBody}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel x:Name="FooterActionsPanel"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Close"
                    Click="CloseButton_Click"
                    Style="{StaticResource FeedWindowPrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>