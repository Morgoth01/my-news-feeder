<Window x:Class="MyNewsFeeder.Views.ImportantNotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Latest Important Feeds"
        Height="560"
        Width="920"
        MinHeight="420"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <ContextMenu x:Key="NotificationItemContextMenu">
            <MenuItem Header="Read Later"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="ReadLaterMenuItem_Click"/>
            <MenuItem Header="Pin"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="PinMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Clear"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Click="ClearMenuItem_Click"/>
        </ContextMenu>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Latest Important Feeds"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView x:Name="NotificationsListView"
                      Grid.Row="0"
                      Margin="0,0,0,8"
                      MouseDoubleClick="NotificationsListView_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderBrush"
                                Value="Transparent"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Padding"
                                Value="2,1"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource MaterialDesignBody}"/>
                        <Setter Property="ContextMenu"
                                Value="{StaticResource NotificationItemContextMenu}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="RowBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <GridViewRowPresenter
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#673AB7"/>
                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#8B6ADB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="RowBorder" Property="Background" Value="#5A33A6"/>
                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#7A56C2"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </MultiTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#7A56C2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="RemoveColumn" Header="" Width="48">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="X"
                                            ToolTip="Remove from list"
                                            Width="28"
                                            Height="24"
                                            Padding="0"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Click="RemoveItemButton_Click"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ReceivedColumn" Header="Received" Width="150" DisplayMemberBinding="{Binding ReceivedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                        <GridViewColumn x:Name="PublishedColumn" Header="Published" Width="150" DisplayMemberBinding="{Binding PublicationDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                        <GridViewColumn x:Name="FeedColumn" Header="Feed" Width="180" DisplayMemberBinding="{Binding FeedName}"/>
                        <GridViewColumn x:Name="TitleColumn" Header="Title" Width="390" DisplayMemberBinding="{Binding Title}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock x:Name="EmptyStateText"
                       Grid.Row="1"
                       Text="No important notifications yet."
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       FontStyle="Italic"
                       Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Auto cleanup:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="RetentionComboBox"
                              Width="170"
                              SelectionChanged="RetentionComboBox_SelectionChanged"
                              DisplayMemberPath="Label"/>
                </StackPanel>
                <TextBlock x:Name="StorageHintText"
                           Text="List stores up to 200 entries."
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Clear All"
                        Click="ClearAllButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Open Article"
                        Click="OpenArticleButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Copy Link"
                        Click="CopyLinkButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Close"
                        Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>