<Window x:Class="MyNewsFeeder.Views.LabelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Manage Labels"
        Height="660"
        Width="1080"
        MinHeight="560"
        MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <Style x:Key="LabelManagerActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="102"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DarkMode}" Value="True">
                    <Setter Property="Foreground" Value="#F7F2FF"/>
                    <Setter Property="BorderBrush" Value="#C7A6FF"/>
                    <Setter Property="Background" Value="#4D4D4D"/>
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                    <Setter Property="Background" Value="#F4F4F4"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                        <Condition Binding="{Binding DarkMode}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#BEBEBE"/>
                    <Setter Property="BorderBrush" Value="#7A7A7A"/>
                    <Setter Property="Background" Value="#505050"/>
                </MultiDataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5EEFF"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding DarkMode}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#5A5A5A"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelManagerPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="124"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelManagerCompactActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LabelManagerActionButtonStyle}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="LabelManagerCompactPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource LabelManagerPrimaryButtonStyle}">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Labels"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
            <TextBlock Text="Create reusable article labels with a name and color."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.72*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.28*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Existing Labels"
                      Style="{StaticResource MaterialDesignCardGroupBox}">
                <Grid Margin="14">
                    <ListView x:Name="LabelsListView"
                              SelectionChanged="LabelsListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Color" Width="72">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="34"
                                                    Height="16"
                                                    CornerRadius="8"
                                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="1"
                                                    Background="{Binding ColorHex}"
                                                    HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" Width="132" DisplayMemberBinding="{Binding Name}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="Edit Label"
                      Style="{StaticResource MaterialDesignCardGroupBox}">
                <StackPanel Margin="14">
                    <TextBox x:Name="LabelNameTextBox"
                             TextChanged="LabelNameTextBox_TextChanged"
                             materialDesign:HintAssist.Hint="Label name"/>
                    <ComboBox x:Name="ColorComboBox"
                              Margin="0,14,0,0"
                              SelectionChanged="ColorComboBox_SelectionChanged"
                              materialDesign:HintAssist.Hint="Color">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Border Width="22"
                                            Height="14"
                                            CornerRadius="7"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1"
                                            Background="{Binding ColorHex}"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox x:Name="CustomColorNameTextBox"
                             Margin="0,12,0,0"
                             materialDesign:HintAssist.Hint="Saved color name"/>

                    <TextBox x:Name="CustomColorTextBox"
                             Margin="0,12,0,0"
                             TextChanged="CustomColorTextBox_TextChanged"
                             materialDesign:HintAssist.Hint="Custom color (#RRGGBB)"/>

                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Button Content="Pick Color"
                                Click="PickCustomColorButton_Click"
                                Style="{StaticResource LabelManagerCompactActionButtonStyle}"
                                Margin="0,0,8,10"/>
                        <Button Content="Save Color"
                                Click="SaveCustomColorButton_Click"
                                Style="{StaticResource LabelManagerCompactActionButtonStyle}"
                                Margin="0,0,8,10"/>
                        <Button Content="Delete Color"
                                Click="DeleteCustomColorButton_Click"
                                Style="{StaticResource LabelManagerCompactActionButtonStyle}"
                                Margin="0,0,0,10"/>
                    </StackPanel>
                    <TextBlock Text="Save your own named colors once and reuse them later from the color list."
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               TextWrapping="Wrap"/>

                    <Border Margin="0,16,0,0"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <TextBlock Text="Preview"
                                       FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Border x:Name="PreviewChip"
                                        Padding="10,4"
                                        CornerRadius="14"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        Background="#7C3AED">
                                    <TextBlock x:Name="PreviewChipText"
                                               Text="Label"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,18,0,0"
                               Orientation="Horizontal"
                               HorizontalAlignment="Left">
                        <Button Content="Save Label"
                                Click="SaveLabelButton_Click"
                                Style="{StaticResource LabelManagerCompactPrimaryButtonStyle}"
                                Margin="0,0,10,10"/>
                        <Button Content="New"
                                Click="NewLabelButton_Click"
                                Style="{StaticResource LabelManagerCompactActionButtonStyle}"
                                Margin="0,0,10,10"/>
                        <Button Content="Delete"
                                Click="DeleteLabelButton_Click"
                                Style="{StaticResource LabelManagerCompactActionButtonStyle}"
                                Margin="0,0,0,10"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Close"
                    Click="CloseButton_Click"
                    Style="{StaticResource LabelManagerPrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>