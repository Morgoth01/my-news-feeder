                                                                            <Setter Property="BorderThickness" Value="3"/>
                                                                            <Setter Property="TextElement.Foreground" Value="White"/>
                                                                            <Setter Property="Effect">
                                                                                <Setter.Value>
                                                                                    <DropShadowEffect Color="#FF80FF"
                                                                                                      BlurRadius="12"
                                                                                                      ShadowDepth="0"
                                                                                                      Opacity="0.45"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsNavigationSelected}" Value="True"/>
                                                                                <Condition Binding="{Binding DataContext.DarkMode, ElementName=RootWindow}" Value="False"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Background" Value="#221642"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
