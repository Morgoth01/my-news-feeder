                                                                              BlurRadius="12"
                                                                              ShadowDepth="0"
                                                                              Opacity="0.45"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle x:Name="MainListUnreadStripe"
                                                   Width="4"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   Fill="{DynamicResource UnreadDotBrush}"
                                                   VerticalAlignment="Stretch"
                                                   Visibility="Collapsed"/>
                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,0,0">
                                            <TextBlock x:Name="MainListTitleText"
                                                       Text="{Binding Title}"
                                                       Foreground="{DynamicResource MaterialDesignBody}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock x:Name="MainListDescriptionText"
                                                       Text="{Binding Description, Converter={StaticResource HtmlToPlainTextConverter}}"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       Margin="0,2,0,4"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed"/>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <materialDesign:PackIcon x:Name="MainListClockIcon"
                                                                         Kind="ClockOutline"
                                                                         Width="14"
                                                                         Height="14"
                                                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                         Margin="0,0,6,0"/>
                                                <TextBlock x:Name="MainListPublicationText"
                                                           Text="{Binding PublicationDate, StringFormat={}{0:dd.MM. HH:mm}}"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="11"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock x:Name="MainListSeparatorText"
                                                           Text="•"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="11"
                                                           Margin="0,0,6,0"/>
                                                <TextBlock x:Name="MainListFeedText"
                                                           Text="{Binding FeedName}"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="180"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.DarkMode, ElementName=RootWindow}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="MainListTitleText" Property="Foreground" Value="White"/>
                                        <Setter TargetName="MainListDescriptionText" Property="Foreground" Value="#E0E0E0"/>
                                        <Setter TargetName="MainListClockIcon" Property="Foreground" Value="#CFCFCF"/>
                                        <Setter TargetName="MainListPublicationText" Property="Foreground" Value="#CFCFCF"/>
                                        <Setter TargetName="MainListSeparatorText" Property="Foreground" Value="#CFCFCF"/>
                                        <Setter TargetName="MainListFeedText" Property="Foreground" Value="#CFCFCF"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.DarkMode, ElementName=RootWindow}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="MainListTitleText" Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                        <Setter TargetName="MainListDescriptionText" Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                        <Setter TargetName="MainListClockIcon" Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                        <Setter TargetName="MainListPublicationText" Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                        <Setter TargetName="MainListSeparatorText" Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                        <Setter TargetName="MainListFeedText" Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                        <Setter TargetName="MainListUnreadStripe" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="MainListTitleText" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.UseCompactArticleCards, ElementName=RootWindow}" Value="True">
                                        <Setter TargetName="ArticleListCard" Property="Padding" Value="8,6"/>
                                        <Setter TargetName="MainListTitleText" Property="FontSize" Value="13"/>
                                        <Setter TargetName="MainListDescriptionText" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.UseCompactArticleCards, ElementName=RootWindow}" Value="False">
                                        <Setter TargetName="MainListDescriptionText" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Description}" Value="">
                                        <Setter TargetName="MainListDescriptionText" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                        <Setter TargetName="MainListDescriptionText" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter x:Name="ArticleListVerticalSplitter"
                          Grid.Column="5"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource MaterialDesignDivider}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Article Content and Browser -->
            <Grid x:Name="ArticleBrowserGrid"
                  Grid.Column="6">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ArticleContentRow"
                                   Height="*"
                                   MinHeight="200"/>
                    <RowDefinition x:Name="ArticleBrowserSplitterRow"
                                   Height="5"/>
                    <RowDefinition x:Name="BrowserContentRow"
                                   Height="*"
                                   MinHeight="200"/>
                </Grid.RowDefinitions>

                <!-- Article Content with Dark Mode Support -->
                <Border x:Name="ArticleContentPane"
                        Grid.Row="0"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        Margin="5"
                        Background="{DynamicResource MaterialDesignPaper}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Article Header with Show Content Button -->
                        <Grid Grid.Row="0"
                              Background="{DynamicResource MaterialDesignToolBarBackground}"
                              Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="{Binding ShowContentButtonText}"
                                        Command="{Binding ShowContentCommand}"
                                        Margin="0,0,8,0"
                                        Height="30">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShowContentAlwaysOn}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter Property="ToolTip"
                                                            Value="Always-On mode is active"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsShowContentAlwaysOn}"
                                                             Value="False">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter Property="ToolTip"
                                                            Value="Click to show/hide content"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="1"
                                        Content="{Binding ReaderModeButtonText}"
                                        Command="{Binding ToggleReaderModeCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="0,0,8,0"
                                        Height="30"/>

                                <Button Grid.Column="2"
                                        Content="{Binding CopyLinkButtonText}"
                                        Command="{Binding CopyLinkCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="30"/>
                            </Grid>

                            <Button Grid.Column="2"
                                    Content="📏"
                                    ToolTip="Auto-adjust height"
                                    Command="{Binding AutoAdjustHeightCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="30"
                                    Height="30"
                                    Margin="2"/>
                        </Grid>

                        <wv:WebView2 x:Name="articleWebView"
                                     Grid.Row="1"
                                     Margin="2"
                                     Visibility="{Binding IsNotLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                <!-- Horizontal Splitter -->
                <GridSplitter x:Name="ArticleHorizontalSplitter"
                              Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource MaterialDesignDivider}"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              Cursor="SizeNS"
                              DragCompleted="GridSplitter_DragCompleted"/>

                <!-- Placeholder bar -->
                <Border x:Name="BrowserPlaceholderBorder"
                        Grid.Row="2"
                        Background="Transparent"
                        MinHeight="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBrowserVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Browser Pane -->
                <Border x:Name="BrowserPane"
                        Grid.Row="2"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        Margin="5"
                        Background="{DynamicResource MaterialDesignPaper}"
                        Visibility="{Binding IsBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MinHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ToolBar Grid.Row="0"
                                 Style="{StaticResource MaterialDesignToolBar}">
                            <Button ToolTip="Reload article"
                                    Command="{Binding BrowserReloadCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="40"
                                    Height="40"
                                    Padding="6">
                                <materialDesign:PackIcon Kind="Refresh"
                                                         Width="20"
                                                         Height="20"
                                                         Foreground="{DynamicResource MaterialDesignBody}"/>
                            </Button>
                            <Button ToolTip="Allow embedded media on this page. Some sites need this for custom video players."
                                    Command="{Binding EnableEmbeddedVideoCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    Padding="10,0"
                                    Visibility="{Binding IsEmbeddedVideoButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlayCircleOutline"
                                                             Width="20"
                                                             Height="20"
                                                             Margin="0,0,6,0"
                                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock Text="{Binding EnableVideoButtonText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Separator Visibility="{Binding IsEmbeddedVideoButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button ToolTip="{Binding ContentFullscreenToolTip}"
                                    Command="{Binding ToggleContentFullscreenCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="40"
                                    Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20"
                                                             Height="20"
                                                             Margin="0,0,6,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Fullscreen"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsContentFullscreen}" Value="True">
                                                        <Setter Property="Kind" Value="FullscreenExit"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Text="{Binding ContentFullscreenButtonText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Separator/>
                            <TextBlock Text="{Binding SelectedArticleLink}"
                                       VerticalAlignment="Center"
                                       Margin="5,0"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="300"/>
                            <Separator/>
                            <TextBlock Text="Click and drag to change the size of the browser window"
                                       VerticalAlignment="Center"
                                       Margin="5,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </ToolBar>

                        <wv:WebView2 x:Name="linkWebView"
                                     Grid.Row="1"
                                     Margin="2"
                                     Visibility="{Binding IsNotLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Grid Grid.Row="1"
                              Margin="2"
                              Background="{DynamicResource MaterialDesignPaper}"
                              Panel.ZIndex="20"
                              IsHitTestVisible="True"
                              Visibility="{Binding ShowBrowserLoadingOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical">
                                <Image Source="pack://application:,,,/Resources/mynewsfeeder.ico"
                                       Width="88"
                                       Height="88"
                                       Margin="0,0,0,10"
                                       Stretch="Uniform"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <RotateTransform x:Name="BrowserLogoSpinner" Angle="0"/>
                                    </Image.RenderTransform>
                                    <Image.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="BrowserLogoSpinner"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0"
                                                                     To="360"
                                                                     Duration="0:0:1.25"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Image.Triggers>
                                </Image>
                                <TextBlock Text="Loading page..."
                                           Foreground="{DynamicResource MaterialDesignBody}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="2"
              Background="#B3000000"
              Panel.ZIndex="999"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsHitTestVisible="True"
              Visibility="{Binding ShowLoadingOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0"
                        Orientation="Vertical">
                <Image x:Name="LoadingLogo"
                       Source="pack://application:,,,/Resources/mynewsfeeder.ico"
                       Width="110"
                       Height="110"
                       Margin="0,0,0,12"
                       Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.5"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="LogoSpinner" Angle="0"/>
                    </Image.RenderTransform>
                    <Image.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="LogoSpinner"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360"
                                                     Duration="0:0:1.25"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Image.Triggers>
                </Image>
                <TextBlock Text="Loading your feeds..."
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Refresh summary toast -->
        <materialDesign:Snackbar x:Name="RefreshSummarySnackbar"
                                 MessageQueue="{Binding SnackbarMessageQueue}"
                                 Grid.RowSpan="2"
                                 Margin="12"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 MaxWidth="520"
                                 Panel.ZIndex="1200"
                                 IsHitTestVisible="False"/>
    </Grid>
</Window>