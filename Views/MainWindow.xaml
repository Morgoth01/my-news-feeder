
<Window x:Class="MyNewsFeeder.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:MyNewsFeeder.ViewModels"
        xmlns:conv="clr-namespace:MyNewsFeeder.Converters"
        xmlns:models="clr-namespace:MyNewsFeeder.Models"
        xmlns:behaviors="clr-namespace:MyNewsFeeder.Views.Behaviors"
        Title="My News Feeder"
        Height="700"
        Width="1200"
        MinHeight="500"
        MinWidth="800"
        WindowState="Normal"
        ResizeMode="CanResize"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Loaded="MainWindow_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter"/>
        <conv:MultiStringEqualsConverter x:Key="MultiStringEqualsConverter"/>
        <conv:BooleanToTextConverter x:Key="BooleanToTextConverter"/>
        <conv:HtmlToPlainTextConverter x:Key="HtmlToPlainTextConverter"/>
        <conv:CollectionViewGroupCategoryConverter x:Key="CollectionViewGroupCategoryConverter"/>

        <!-- Modern context menu styling (light/dark aware) -->
        <Style x:Key="ArticleContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ArticleMenuItemStyle" TargetType="MenuItem">
            <Style.Resources>
                <!-- Make icons follow the current menu item foreground (for contrast on hover/checked) -->
                <Style TargetType="materialDesign:PackIcon">
                    <Setter Property="Foreground"
                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                </Style>
            </Style.Resources>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Icon" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Icon"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPaper}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Outer" Property="Background" Value="#33272727"/>
                            </Trigger>
                            <!-- Ensure good contrast when a checked item is highlighted -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPaper}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HelpContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HelpMenuItemStyle" TargetType="MenuItem">
            <Style.Resources>
                <Style TargetType="materialDesign:PackIcon">
                    <Setter Property="Foreground"
                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                </Style>
            </Style.Resources>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <Grid Margin="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="2"
                                                  ContentSource="InputGestureText"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0,0,0"
                                                  Opacity="0.9"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignPaper}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HelpMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="{DynamicResource MaterialDesignDivider}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Up"
                    Command="{Binding NavigateSelectionCommand}"
                    CommandParameter="-1"/>
        <KeyBinding Key="Down"
                    Command="{Binding NavigateSelectionCommand}"
                    CommandParameter="1"/>
        <KeyBinding Key="PageUp"
                    Command="{Binding NavigateSelectionCommand}"
                    CommandParameter="-5"/>
        <KeyBinding Key="PageDown"
                    Command="{Binding NavigateSelectionCommand}"
                    CommandParameter="5"/>
        <KeyBinding Key="PageUp"
                    Modifiers="Control"
                    Command="{Binding NavigateFeedCommand}"
                    CommandParameter="-1"/>
        <KeyBinding Key="PageDown"
                    Modifiers="Control"
                    Command="{Binding NavigateFeedCommand}"
                    CommandParameter="1"/>
        <KeyBinding Key="R"
                    Modifiers="Control"
                    Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F5"
                    Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="M"
                    Modifiers="Control"
                    Command="{Binding ManageFeedsCommand}"/>
        <KeyBinding Key="D"
                    Modifiers="Control"
                    Command="{Binding ToggleDarkModeCommand}"/>
        <KeyBinding Key="L"
                    Modifiers="Control"
                    Command="{Binding ShowContentCommand}"/>
        <KeyBinding Key="R"
                    Modifiers="Control+Shift"
                    Command="{Binding ToggleReaderModeCommand}"/>
        <KeyBinding Key="P"
                    Modifiers="Control+Shift"
                    Command="{Binding PinSelectedArticleCommand}"/>
        <KeyBinding Key="L"
                    Modifiers="Control+Shift"
                    Command="{Binding ReadLaterSelectedArticleCommand}"/>
        <KeyBinding Key="X"
                    Modifiers="Control+Shift"
                    Command="{Binding ArchiveSelectedArticleCommand}"/>
        <KeyBinding Key="U"
                    Modifiers="Control+Shift"
                    Command="{Binding MarkSelectedArticleUnreadCommand}"/>
        <KeyBinding Key="C"
                    Modifiers="Control+Shift"
                    Command="{Binding CopyLinkCommand}"/>
        <KeyBinding Key="O"
                    Modifiers="Control"
                    Command="{Binding OpenSelectedArticleInWindowCommand}"/>
        <KeyBinding Key="F11"
                    Command="{Binding ToggleContentFullscreenCommand}"/>
        <KeyBinding Key="I"
                    Modifiers="Control"
                    Command="{Binding ShowImportantNotificationsCommand}"/>
        <KeyBinding Key="P"
                    Modifiers="Control+Alt"
                    Command="{Binding OpenLibraryWindowCommand}"/>
        <KeyBinding Key="L"
                    Modifiers="Control+Alt"
                    Command="{Binding OpenReadLaterWindowCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="RootLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainToolbarRow"
                           Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar x:Name="MainToolbar"
                 Grid.Row="0"
                 Style="{StaticResource MaterialDesignToolBar}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="{Binding NextAutoRefreshDisplay}"
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding PendingAutoRefresh, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Manage Feeds"
                            Command="{Binding ManageFeedsCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Separator/>
                    <Button x:Name="HelpMenuButton"
                            Content="Help"
                            ToolTip="Help actions"
                            Click="HelpMenuButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            Margin="5">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource HelpContextMenuStyle}">
                                <MenuItem Header="Content (Help)"
                                          Click="HelpMenuContent_Click"
                                          Style="{StaticResource HelpMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="BookOpenPageVariant"
                                         Width="18"
                                         Height="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Keyboard shortcuts"
                                          Click="HelpMenuShortcuts_Click"
                                          Style="{StaticResource HelpMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="KeyboardOutline"
                                                                 Width="18"
                                                                 Height="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource HelpMenuSeparatorStyle}"/>
                                <MenuItem Header="Check for updates"
                                          Click="HelpMenuCheckUpdates_Click"
                                          Style="{StaticResource HelpMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="CloudDownloadOutline"
                                                                 Width="18"
                                                                 Height="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource HelpMenuSeparatorStyle}"/>
                                <MenuItem Header="About"
                                          Click="HelpMenuAbout_Click"
                                          Style="{StaticResource HelpMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="InformationOutline"
                                                                 Width="18"
                                                                 Height="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="Settings"
                            ToolTip="Application settings"
                            Click="SettingsButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            Margin="5"/>

                    <Separator/>
                    <TextBlock Text="Keyword:"
                               VerticalAlignment="Center"
                               Margin="5,0"/>
                    <TextBox x:Name="KeywordTextBox"
                             Width="150"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button Command="{Binding ShowImportantNotificationsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="4,0,0,0"
                            Padding="8,0"
                            ToolTip="Latest important feeds">
                        <materialDesign:PackIcon Width="22"
                                                 Height="22">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="BellOutline"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasImportantNotifications}" Value="True">
                                            <Setter Property="Kind" Value="Bell"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                </StackPanel>
            </DockPanel>
        </ToolBar>

        <!-- Main Content with Resizable Splitters -->
            <Grid x:Name="MainContentGrid"
                  Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SectionsColumn"
                                  Width="110"/>
                <ColumnDefinition x:Name="SectionsSplitterColumn"
                                  Width="5"/>
                <ColumnDefinition x:Name="ExplorerColumn"
                                  Width="{Binding PendingTreeWidth, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}"
                                  MinWidth="220"/>
                <ColumnDefinition x:Name="ExplorerSplitterColumn"
                                  Width="5"/>
                <ColumnDefinition x:Name="ArticleListColumn"
                                  Width="380"
                                  MinWidth="300"/>
                <ColumnDefinition x:Name="ArticleListSplitterColumn"
                                  Width="5"/>
                <ColumnDefinition x:Name="ArticleBrowserColumn"
                                  Width="*"
                                  MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Section Icons -->
            <Border x:Name="SectionsPane"
                    Grid.Column="0"
                    Margin="5"
                    Padding="6"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style x:Key="SectionShortcutButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Margin" Value="0,4,0,4"/>
                            <Setter Property="Height" Value="55"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#0F1E88E5"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E88E5"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1A7C4DFF"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7C4DFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="Sections"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}"
                               Margin="4,0,0,8"/>
                    <materialDesign:PopupBox StaysOpen="True"
                                             PlacementMode="RightAndAlignTopEdges"
                                             Margin="0,0,0,8"
                                             HorizontalAlignment="Stretch"
                                             Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}">
                <materialDesign:PopupBox.ToggleContent>
                            <Border Padding="6,4"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilterVariant"
                                                             Width="16"
                                                             Height="16"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Filters"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                            </Border>
                        </materialDesign:PopupBox.ToggleContent>
                        <StackPanel Margin="4"
                                    MinWidth="260">
                            <StackPanel.Resources>
                                <Style x:Key="FilterActionButtonStyle"
                                       TargetType="Button"
                                       BasedOn="{StaticResource MaterialDesignFlatButton}">
                                    <!-- Default to accent purple in light mode -->
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.DarkMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <!-- High-contrast light blue for dark mode -->
                                            <Setter Property="Foreground" Value="#64B5F6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="Filter by category"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,6">
                                    <Button Content="Select all"
                                            Command="{Binding SelectAllCategoriesCommand}"
                                            Style="{StaticResource FilterActionButtonStyle}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Clear"
                                            Command="{Binding ClearCategoriesCommand}"
                                            Style="{StaticResource FilterActionButtonStyle}"/>
                            </StackPanel>
                            <ScrollViewer Height="120"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilterCategories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SelectableFilterItem}">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding Name}"
                                                      Foreground="{DynamicResource MaterialDesignBody}"
                                                      Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Separator Margin="0,8,0,8"/>
                            <TextBlock Text="Filter by feed"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,6">
                                    <Button Content="Select all"
                                            Command="{Binding SelectAllFeedsCommand}"
                                            Style="{StaticResource FilterActionButtonStyle}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Clear"
                                            Command="{Binding ClearFeedsCommand}"
                                            Style="{StaticResource FilterActionButtonStyle}"/>
                            </StackPanel>
                            <ScrollViewer Height="120"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilterFeeds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SelectableFilterItem}">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding Name}"
                                                      Foreground="{DynamicResource MaterialDesignBody}"
                                                      Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </materialDesign:PopupBox>
                    <Button x:Name="LibrarySidebarButton"
                            Click="LibrarySidebarButton_Click"
                            Style="{StaticResource SectionShortcutButtonStyle}">
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Bookshelf"
                                                       Width="20"
                                                       Height="20"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,2"/>
                            <TextBlock Text="Library"
                                         FontSize="11"
                                         Margin="0,6,0,0"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShowAllSidebarButton"
                            Click="ShowAllSidebarButton_Click"
                            Style="{StaticResource SectionShortcutButtonStyle}">
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ViewAgendaOutline"
                                                       Width="20"
                                                       Height="20"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,2"/>
                            <TextBlock Text="Show All"
                                         FontSize="11"
                                         Margin="0,6,0,0"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ListBox ItemsSource="{Binding MainVisibleSections}"
                             Background="Transparent"
                             BorderThickness="0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6"/>
                                    <Setter Property="Margin" Value="0,4,0,4"/>
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Margin="0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#0F1E88E5"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1E88E5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#1A7C4DFF"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#7C4DFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ArticleSectionViewModel}">
                                <Border Padding="6"
                                        CornerRadius="8"
                                        Background="{DynamicResource MaterialDesignCardBackground}"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="1"
                                        MouseLeftButtonUp="SectionTile_MouseLeftButtonUp">
                                    <StackPanel Orientation="Vertical"
                                                HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,2"/>
                                        <Border Background="{DynamicResource PrimaryHueMidBrush}"
                                                CornerRadius="6"
                                                Padding="4,1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Margin="0,4,0,0"
                                                Visibility="Collapsed">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasUnread}" Value="True"/>
                                                                <Condition Binding="{Binding HideUnreadIndicators}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding UnreadCount}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="10"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="11"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource MaterialDesignBody}"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Modern Feed Explorer -->
            <Border x:Name="FeedExplorerPane"
                    Grid.Column="2"
                    Margin="5"
                    Padding="6"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1">
                <Border.Resources>
                    <DataTemplate DataType="{x:Type models:FeedItem}">
                        <Border x:Name="ArticleCard"
                                Margin="22,4,6,4"
                                Padding="12,8"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="2"
                                Focusable="True">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.ArticleClickCommand, ElementName=RootWindow}"
                                              CommandParameter="{Binding}"/>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenArticleInWindowCommand, ElementName=RootWindow}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource ArticleContextMenuStyle}">
                                    <MenuItem Header="{Binding IsPinned, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='Unpin|Pin'}"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsPinned}"
                                              Command="{Binding DataContext.PinArticleCommand, Source={x:Reference RootWindow}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Style="{StaticResource ArticleMenuItemStyle}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="PinOutline" Width="16" Height="16" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                                    <MenuItem Header="{Binding IsReadLater, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='Unsave|Read Later'}"
                                                              IsCheckable="True"
                                                              IsChecked="{Binding IsReadLater}"
                                                              Command="{Binding DataContext.ReadLaterArticleCommand, Source={x:Reference RootWindow}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              Style="{StaticResource ArticleMenuItemStyle}">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="ClockOutline"
                                                                                     Width="16"
                                                                                     Height="16"
                                                                                     Margin="0,0,2,0"
                                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                    <MenuItem Header="{Binding IsArchived, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='Unarchive|Archive'}"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsArchived}"
                                              Command="{Binding DataContext.ArchiveArticleCommand, Source={x:Reference RootWindow}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Style="{StaticResource ArticleMenuItemStyle}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="ArchiveOutline"
                                                                     Width="16"
                                                                     Height="16"
                                                                     Margin="0,0,2,0"
                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Unread"
                                              Command="{Binding DataContext.MarkUnreadCommand, Source={x:Reference RootWindow}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource ArticleMenuItemStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="EmailOutline" Width="16" Height="16" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Copy Link"
                                              Command="{Binding DataContext.CopyArticleLinkCommand, Source={x:Reference RootWindow}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Style="{StaticResource ArticleMenuItemStyle}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Pinned">
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Read Later">
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Archive">
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.SuppressAutoScroll, ElementName=RootWindow}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#221642"/>
                                            <Setter Property="BorderBrush" Value="#FF80FF"/>
                                            <Setter Property="BorderThickness" Value="3"/>
                                            <Setter Property="behaviors:BringIntoViewBehavior.Enabled" Value="True"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF80FF"
                                                                      BlurRadius="12"
                                                                      ShadowDepth="0"
                                                                      Opacity="0.45"/>
                                                </Setter.Value>
                                            </Setter>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="UnreadStripe"
                                           Width="4"
                                           RadiusX="2"
                                           RadiusY="2"
                                           Fill="{DynamicResource UnreadDotBrush}"
                                           VerticalAlignment="Stretch"
                                           Visibility="Collapsed"/>
                                <StackPanel Grid.Column="1"
                                            Margin="10,0,0,0">
                                    <TextBlock x:Name="TitleText"
                                               Text="{Binding Title}"
                                               Foreground="{DynamicResource MaterialDesignBody}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="DescriptionText"
                                               Text="{Binding Description, Converter={StaticResource HtmlToPlainTextConverter}}"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               Margin="0,2,0,4"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ClockOutline"
                                                                 Width="14"
                                                                 Height="14"
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding PublicationDate, StringFormat={}{0:dd.MM. HH:mm}}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   FontSize="11"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="•"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   FontSize="11"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FeedName}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                <Setter TargetName="UnreadStripe" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.UseCompactArticleCards, ElementName=RootWindow}" Value="True">
                                <Setter TargetName="ArticleCard" Property="Padding" Value="8,6"/>
                                <Setter TargetName="ArticleCard" Property="Margin" Value="18,2,4,2"/>
                                <Setter TargetName="TitleText" Property="FontSize" Value="13"/>
                                <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.UseCompactArticleCards, ElementName=RootWindow}" Value="False">
                                <Setter TargetName="ArticleCard" Property="Padding" Value="12,8"/>
                                <Setter TargetName="ArticleCard" Property="Margin" Value="22,4,6,4"/>
                                <Setter TargetName="DescriptionText" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Description}" Value="">
                                <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:LoadMoreItem}">
                        <Button Content="Load more"
                                Command="{Binding LoadMoreCommand}"
                                Margin="22,8,0,2"
                                Padding="12,6"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left"/>
                    </DataTemplate>
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="2,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="FeedExplorerHeaderContent"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ViewList"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="Feeds"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,0"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <Button x:Name="ToggleFeedsPaneButton"
                                Grid.Column="1"
                                Click="ToggleFeedsPaneButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="28"
                                Height="28"
                                Padding="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <materialDesign:PackIcon x:Name="ToggleFeedsPaneIcon"
                                                     Kind="ChevronLeft"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="{DynamicResource MaterialDesignBody}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="SectionScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding VisibleSections}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ArticleSectionViewModel}">
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          Margin="0,0,0,10">
                                    <Expander.Header>
                                        <Border Background="#663A2D9B"
                                                Padding="10"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal"
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0">
                                                    <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                             Width="18"
                                                                             Height="18"
                                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                             Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                                </StackPanel>
                                                <Border Background="{DynamicResource PrimaryHueMidBrush}"
                                                        Padding="8,2"
                                                        CornerRadius="8"
                                                        Grid.Column="1"
                                                        Visibility="Collapsed"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding UnreadCount}"
                                                               FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Expander.Header>

                                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8"
                                            Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      Tag="{Binding Name}"
                                                      VirtualizingStackPanel.IsVirtualizing="True"
                                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                      ScrollViewer.CanContentScroll="True">
                                            <ItemsControl.Resources>
                                                <DataTemplate DataType="{x:Type vm:CategoryGroupViewModel}">
                                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                              Margin="0,4,0,6">
                                                    <Expander.Header>
                                                        <Border BorderThickness="3,0,0,0"
                                                                BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                                                Padding="8,6"
                                                                CornerRadius="6">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Pinned">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Read Later">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Archive">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                            <Setter Property="Padding" Value="8,4"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                                <Grid VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal"
                                                                                Grid.Column="0"
                                                                                VerticalAlignment="Center">
                                                                        <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                                                 Width="16"
                                                                                                 Height="16"
                                                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                                                 Margin="0,0,6,0"/>
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                    </StackPanel>
                                                                    <Border Background="{DynamicResource MaterialDesignDivider}"
                                                                            CornerRadius="8"
                                                                            Padding="8,2"
                                                                            Grid.Column="1"
                                                                            Margin="8,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ArticleCount}"
                                                                                   Foreground="{DynamicResource MaterialDesignBody}"
                                                                                   FontWeight="Bold"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding Feeds}"
                                                                      VirtualizingStackPanel.IsVirtualizing="True"
                                                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                                      ScrollViewer.CanContentScroll="True">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:FeedGroupViewModel}">
                                                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                                              Margin="20,2,0,4">
                                                                        <Expander.Header>
                                                                            <Border BorderThickness="3,0,0,0"
                                                                                    BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                                                                    Padding="8,6"
                                                                                    CornerRadius="4">
                                                                                <Border.ContextMenu>
                                                                                    <ContextMenu Style="{StaticResource ArticleContextMenuStyle}">
                                                                                        <MenuItem Header="Show All"
                                                                                                  Command="{Binding DataContext.OpenFeedAllWindowCommand, Source={x:Reference RootWindow}}"
                                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                                  Style="{StaticResource ArticleMenuItemStyle}">
                                                                                            <MenuItem.Icon>
                                                                                                <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                                                            </MenuItem.Icon>
                                                                                        </MenuItem>
                                                                                    </ContextMenu>
                                                                                </Border.ContextMenu>
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Pinned">
                                                                                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Read Later">
                                                                                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Archive">
                                                                                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                                                <Setter Property="Padding" Value="8,4"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                <Grid VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal"
                                                                                Grid.Column="0"
                                                                                VerticalAlignment="Center"
                                                                                Margin="4,0,0,0">
                                                                                        <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                                                                 Width="14"
                                                                                                                 Height="14"
                                                                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                                                                 Opacity="0.8"
                                                                                                                 Margin="0,0,6,0"/>
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                                    </StackPanel>
                                                            <Border Background="{DynamicResource MaterialDesignDivider}"
                                                                    CornerRadius="8"
                                                                    Padding="6,2"
                                                                    Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ItemCount}"
                                                                           Foreground="{DynamicResource MaterialDesignBody}"
                                                                           FontWeight="Bold"/>
                                                            </Border>
                                                            <Border Grid.Column="2"
                                                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                                                    CornerRadius="8"
                                                                    Padding="6,2"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                <TextBlock Text="{Binding UnreadCount}"
                                                                           Foreground="White"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="11"
                                                                           ToolTip="Unread in this feed"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding PagedItems}"
                                                                      Tag="{Binding Category}"
                                                                      VirtualizingStackPanel.IsVirtualizing="True"
                                                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                                      ScrollViewer.CanContentScroll="True"/>
                                                                    </Expander>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>

                                                <DataTemplate DataType="{x:Type vm:FeedGroupViewModel}">
                                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                              Margin="0,2,0,6">
                                                        <Expander.Header>
                                                            <Border BorderThickness="3,0,0,0"
                                                                    BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                                                    Padding="8,6"
                                                                    CornerRadius="4">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu Style="{StaticResource ArticleContextMenuStyle}">
                                                                        <MenuItem Header="Show All"
                                                                                  Command="{Binding DataContext.OpenFeedAllWindowCommand, Source={x:Reference RootWindow}}"
                                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                  Style="{StaticResource ArticleMenuItemStyle}">
                                                                            <MenuItem.Icon>
                                                                                <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Category}" Value="Pinned">
                                                                                <Setter Property="BorderBrush" Value="#4C6EE3"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Category}" Value="Read Later">
                                                                                <Setter Property="BorderBrush" Value="#FFB74D"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Category}" Value="Archive">
                                                                                <Setter Property="BorderBrush" Value="#90A4AE"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                                <Setter Property="Padding" Value="8,4"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Orientation="Horizontal"
                                                                                Grid.Column="0"
                                                                                VerticalAlignment="Center">
                                                                        <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                                                 Width="14"
                                                                                                 Height="14"
                                                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                                                 Opacity="0.8"
                                                                                                 Margin="0,0,6,0"/>
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                    </StackPanel>
