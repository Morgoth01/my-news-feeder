<Window x:Class="MyNewsFeeder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:MyNewsFeeder.ViewModels"
        xmlns:sel="clr-namespace:MyNewsFeeder.Views"
        xmlns:conv="clr-namespace:MyNewsFeeder.Converters"
        xmlns:models="clr-namespace:MyNewsFeeder.Models"
        Title="My News Feeder"
        Height="700"
        Width="1200"
        MinHeight="500"
        MinWidth="800"
        WindowState="Normal"
        ResizeMode="CanResize"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Loaded="MainWindow_Loaded"
        Closing="Window_Closing">

    <!-- Enhanced Converter Registration -->
    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter"/>
        <Style x:Key="CategoryContainerStyle"
               TargetType="TreeViewItem"
               BasedOn="{StaticResource MaterialDesignTreeViewItem}">
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MaterialDesignBody}"/>
            <EventSetter Event="Expanded"
                         Handler="TreeViewItem_ExpandedCollapsed"/>
            <EventSetter Event="Collapsed"
                         Handler="TreeViewItem_ExpandedCollapsed"/>
        </Style>
        <Style x:Key="FeedContainerStyle"
               TargetType="TreeViewItem"
               BasedOn="{StaticResource MaterialDesignTreeViewItem}">
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MaterialDesignBody}"/>
            <EventSetter Event="Expanded"
                         Handler="TreeViewItem_ExpandedCollapsed"/>
            <EventSetter Event="Collapsed"
                         Handler="TreeViewItem_ExpandedCollapsed"/>
        </Style>
        <Style x:Key="DefaultContainerStyle"
               TargetType="TreeViewItem"
               BasedOn="{StaticResource MaterialDesignTreeViewItem}">
            <Setter Property="Foreground"
                    Value="{DynamicResource MaterialDesignBody}"/>
            <EventSetter Event="Expanded"
                         Handler="TreeViewItem_ExpandedCollapsed"/>
            <EventSetter Event="Collapsed"
                         Handler="TreeViewItem_ExpandedCollapsed"/>
        </Style>
        <sel:TreeViewItemStyleSelector x:Key="TvItemStyleSelector"
                                       CategoryStyle="{StaticResource CategoryContainerStyle}"
                                       FeedStyle="{StaticResource FeedContainerStyle}"
                                       DefaultStyle="{StaticResource DefaultContainerStyle}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0"
                 Style="{StaticResource MaterialDesignToolBar}">
            <Button Content="Manage Feeds"
                    Command="{Binding ManageFeedsCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Separator/>
            <Button Content="About"
                    ToolTip="About MyNewsFeeder"
                    Click="AboutButton_Click"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    Margin="5"/>

            <Separator/>
            <TextBlock Text="Keyword:"
                       VerticalAlignment="Center"
                       Margin="5,0"/>
            <TextBox Width="150"
                     Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                     Margin="5,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RefreshCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Separator/>
            <materialDesign:PopupBox x:Name="SettingsPopupBox"
                                     StaysOpen="True">
                <StackPanel Background="{DynamicResource MaterialDesignPaper}"
                            Margin="8"
                            MinWidth="250">
                    <TextBlock Text="Settings"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="4,4,4,8"
                               Foreground="{DynamicResource MaterialDesignBody}"/>

                    <!-- Existing Settings -->
                    <CheckBox Content="Dark Mode"
                              IsChecked="{Binding DarkMode}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Margin="4"/>
                    <CheckBox Content="Auto Refresh"
                              IsChecked="{Binding AutoRefresh}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Margin="4"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="4,0,4,4"
                                Visibility="{Binding AutoRefresh, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Interval:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   Margin="20,0,8,0"/>
                        <ComboBox Width="120"
                                  ItemsSource="{Binding AvailableRefreshIntervals}"
                                  SelectedItem="{Binding AutoRefreshIntervalMinutes}"
                                  Style="{StaticResource MaterialDesignComboBox}"
                                  ToolTip="Select auto-refresh interval">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} min">
                                                <Binding/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="{Binding AutoRefreshIntervalDisplay}"
                               FontSize="10"
                               Margin="24,0,4,4"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Visibility="{Binding AutoRefresh, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <CheckBox Content="Enable AdBlocker"
                              IsChecked="{Binding AdBlockerEnabled}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Margin="4"/>
                    <CheckBox Content="Hide advertisement articles"
                              IsChecked="{Binding AdvertisementFilterEnabled}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Margin="4"
                              ToolTip="Filter feed items that look like ads based on configurable keywords."/>
                    <TextBlock Text="Filter keywords (one per line)"
                               Margin="24,0,4,2"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Visibility="{Binding AdvertisementFilterEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                               FontSize="10"/>
                    <TextBox Text="{Binding AdvertisementKeywordsText, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True"
                             Height="96"
                             Margin="24,0,4,4"
                             VerticalScrollBarVisibility="Auto"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             Background="{DynamicResource MaterialDesignPaper}"
                             Style="{StaticResource MaterialDesignTextBox}"
                             Visibility="{Binding AdvertisementFilterEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                             TextWrapping="Wrap"/>

                    <!-- Always-On Content -->
                    <CheckBox Content="Show Content Always-On"
                              IsChecked="{Binding IsShowContentAlwaysOn}"
                              ToolTip="Keep browser window open and auto-load articles when switching"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Margin="4"/>

                    <Separator Margin="4"/>

                    <!-- Feed Count Settings -->
                    <TextBlock Text="Feed Settings"
                               FontWeight="Bold"
                               FontSize="12"
                               Margin="4,8,4,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="4">
                        <TextBlock Text="Max Articles per Feed:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   Margin="0,0,8,0"/>
                        <TextBox Width="60"
                                 Text="{Binding MaxFeeds, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 ToolTip="Number of articles to load per feed (1-50)"/>
                        <TextBlock Text="(1-50)"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>

                    <!-- Cache Management-->
                    <TextBlock Text="Cache Management"
                               FontWeight="Bold"
                               FontSize="12"
                               Margin="4,8,4,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>

                    <Button Content="Clear Browser Cache"
                            Command="{Binding ClearCacheCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            Margin="4"
                            ToolTip="Clear cached images, files and browsing data to free up space"/>

                    <TextBlock Text="Automatically clears old cache every 2 hours"
                               FontSize="10"
                               Margin="4,0,4,4"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               TextWrapping="Wrap"/>

                    <!-- Display current settings -->
                    <TextBlock Text="{Binding CurrentFeedSettingsDisplay}"
                               FontSize="10"
                               Margin="4,0,4,4"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               TextWrapping="Wrap"/>

                    <Separator Margin="4"/>

                    <!-- Existing AdBlocker Settings -->
                    <Button Content="AdBlocker Settings"
                            Command="{Binding AdBlockerSettingsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            Margin="4"/>

                    <Separator Margin="4"/>

                    <!-- : Action buttons with proper closing -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="4">

                        <!-- Save button with adaptive styling -->
                        <Button Content="Save Feed Settings"
                                Command="{Binding SaveSettingsCommand}"
                                Margin="0,0,8,0"
                                ToolTip="Save feed count settings and refresh feeds">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Background"
                                            Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Reset button with adaptive styling -->
                        <Button Content="Reset to Default"
                                Command="{Binding ResetSettingsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                Margin="0,0,8,0"
                                ToolTip="Reset feed settings to default values"/>

                        <!-- Close button -->
                        <Button Content="Close"
                                Click="CloseSettingsPopup_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{DynamicResource MaterialDesignBody}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:PopupBox>
        </ToolBar>

        <!-- Main Content with Resizable Splitters -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding TreeWidth, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}"
                                  MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"
                                  MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Feed Tree -->
            <TreeView x:Name="FeedTreeView"
                      Grid.Column="0"
                      ItemsSource="{Binding CategoryGroups}"
                      ItemContainerStyleSelector="{StaticResource TvItemStyleSelector}"
                      SelectedItemChanged="TreeView_SelectedItemChanged"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      Margin="5"
                      Background="{DynamicResource MaterialDesignPaper}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Feeds}">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,2">
                            <StackPanel.ToolTip>
                                <StackPanel>
                                    <TextBlock Text="{Binding ArticleCount, StringFormat=Gesamt: {0}}"/>
                                    <TextBlock Text="{Binding UnreadCount, StringFormat=Ungelesen: {0}}"/>
                                </StackPanel>
                            </StackPanel.ToolTip>
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{DynamicResource UnreadDotBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"
                                    Effect="{DynamicResource GlowPurpleEffect}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                     Width="18"
                                                     Height="18"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Margin="0,0,4,0"/>
                        </StackPanel>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding PagedItems}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,2">
                                    <StackPanel.ToolTip>
                                        <TextBlock Text="{Binding ItemCount, StringFormat=Articles: {0}}"/>
                                    </StackPanel.ToolTip>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{DynamicResource UnreadDotBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"
                                             Effect="{DynamicResource GlowPurpleEffect}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.Resources>
                                                <DataTemplate DataType="{x:Type models:FeedItem}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,2">
                                                        <Ellipse Width="9"
                                                                 Height="9"
                                                                 Fill="{DynamicResource UnreadDotBrush}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,6,0"
                                                                 SnapsToDevicePixels="True">
                                                            <Ellipse.Effect>
                                                                <StaticResource ResourceKey="GlowPurpleEffect"/>
                                                            </Ellipse.Effect>
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Opacity" Value="0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                                                 Width="14"
                                                                                 Height="14"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                                 Margin="0,0,6,0"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="220"
                                                                       Foreground="{DynamicResource MaterialDesignBody}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding PublicationDate, StringFormat={}{0:dd.MM. HH:mm}}"
                                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                       FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>

                                                <DataTemplate DataType="{x:Type vm:LoadMoreItem}">
                                                    <Button Content="Load more"
                                                            Command="{Binding LoadMoreCommand}"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,4,0,0"
                                                            Padding="12,4"
                                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                </DataTemplate>
                                            </ContentControl.Resources>
                                        </ContentControl>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource MaterialDesignDivider}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- : Article Content and Browser with Dynamic Sizing -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- CHANGED: Use Star sizing for dynamic resizing -->
                    <RowDefinition Height="*"
                                   MinHeight="200"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"
                                   MinHeight="200"/>
                </Grid.RowDefinitions>

                <!-- Article Content with Dark Mode Support -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        Margin="5"
                        Background="{DynamicResource MaterialDesignPaper}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Article Header with Show Content Button -->
                        <Grid Grid.Row="0"
                              Background="{DynamicResource MaterialDesignToolBarBackground}"
                              Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Container for Show Content and Copy Link buttons -->
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Show Content button column -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Copy Link button column -->
                                </Grid.ColumnDefinitions>

                                <!-- Show Content Button -->
                                <Button Grid.Column="0"
                                        Content="{Binding ShowContentButtonText}"
                                        Command="{Binding ShowContentCommand}"
                                        Margin="0,0,8,0"
                                        Height="30">
                                    <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsShowContentAlwaysOn}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                            <Setter Property="ToolTip"
                                                                    Value="Always-On mode is active"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsShowContentAlwaysOn}"
                                                                     Value="False">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter Property="ToolTip"
                                                            Value="Click to show/hide content"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Copy Link Button -->
                                <Button Grid.Column="1"
                                        Content="{Binding CopyLinkButtonText}"
                                        Command="{Binding CopyLinkCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="30"/>
                            </Grid>

                            <!-- Auto-adjust height button -->
                            <Button Grid.Column="2"
                                    Content="📏"
                                    ToolTip="Auto-adjust height"
                                    Command="{Binding AutoAdjustHeightCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="30"
                                    Height="30"
                                    Margin="2"/>
                        </Grid>

                        <!-- Article WebView -->
                        <wv:WebView2 x:Name="articleWebView"
                                     Grid.Row="1"
                                     Margin="2"/>
                    </Grid>
                </Border>

                <!-- Horizontal Splitter with size change tracking -->
                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource MaterialDesignDivider}"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows"
                              Cursor="SizeNS"
                              DragCompleted="GridSplitter_DragCompleted"/>

                <!-- Placeholder bar keeps splitter usable when browser is hidden -->
                <Border Grid.Row="2"
                        Background="Transparent"
                        MinHeight="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBrowserVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- : Dynamic Browser Window that extends to bottom -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        Margin="5"
                        Background="{DynamicResource MaterialDesignPaper}"
                        Visibility="{Binding IsBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MinHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Browser Controls with better layout -->
                        <ToolBar Grid.Row="0"
                                 Style="{StaticResource MaterialDesignToolBar}">
                            <Button Content="⬅"
                                    ToolTip="Back"
                                    Command="{Binding BrowserBackCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="30"
                                    Height="30"/>
                            <Button Content="➡"
                                    ToolTip="Forward"
                                    Command="{Binding BrowserForwardCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="30"
                                    Height="30"/>
                            <Button Content="🔄"
                                    ToolTip="Reload"
                                    Command="{Binding BrowserReloadCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="30"
                                    Height="30"/>
                            <Separator/>
                            <TextBlock Text="{Binding SelectedArticleLink}"
                                       VerticalAlignment="Center"
                                       Margin="5,0"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="300"/>
                            <Separator/>
                            <TextBlock Text="Click and drag to change the size of the browser window"
                                       VerticalAlignment="Center"
                                       Margin="5,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </ToolBar>

                        <!-- External Browser WebView - NOW DYNAMIC -->
                        <wv:WebView2 x:Name="linkWebView"
                                     Grid.Row="1"
                                     Margin="2"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>